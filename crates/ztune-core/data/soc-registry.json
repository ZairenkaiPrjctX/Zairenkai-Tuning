{
  "schema_version": 1,
  "note": "SoC family registry for ztune. Detection is open-ended: any identifier matching a family rule is reported with its raw value, listed or not. known_platforms (generated by scripts/update-soc-registry.py) only says which identifiers mainline Linux knows. Annotations are display labels with a source; they never decide support, profiles or writes. A model prefix matches when it is followed by a digit and then only [0-9a-z]; board-level compatibles such as qcom,sm8250-mtp therefore do not match.",
  "sources": [
    {
      "id": "konabess",
      "url": "https://github.com/libxzr/KonaBess",
      "commit": "ff387dc7f630d7460c7a6561f83f71846217ee27",
      "paths": [
        "app/src/main/java/xzr/konabess/KonaBessCore.java",
        "app/src/main/java/xzr/konabess/ChipInfo.java",
        "app/src/main/res/values/strings.xml"
      ],
      "license": "GPL-3.0",
      "use": "device tree model codenames and the chip labels KonaBess shows for them"
    },
    {
      "id": "lineage-gs101",
      "url": "https://github.com/LineageOS/android_device_google_gs101",
      "commit": "750d40c550dfeb6d158ead9d8ee726a616d22e9e",
      "paths": [
        "BoardConfig-common.mk (TARGET_BOARD_PLATFORM := gs101)"
      ],
      "license": "Apache-2.0",
      "use": "ro.board.platform value of a Tensor platform"
    },
    {
      "id": "lineage-gs201",
      "url": "https://github.com/LineageOS/android_device_google_gs201",
      "commit": "f75ebcf4ce727966f026f89b5c28721caa15bb61",
      "paths": [
        "BoardConfig (TARGET_BOARD_PLATFORM := gs201)"
      ],
      "license": "Apache-2.0",
      "use": "ro.board.platform value of a Tensor platform"
    },
    {
      "id": "lineage-zuma",
      "url": "https://github.com/LineageOS/android_device_google_zuma",
      "commit": "9eeeb27bf309b1d3bd5e714e1ce9c22d35babfbe",
      "paths": [
        "BoardConfig (TARGET_BOARD_PLATFORM := zuma)"
      ],
      "license": "Apache-2.0",
      "use": "ro.board.platform value of a Tensor platform"
    },
    {
      "id": "lineage-garnet",
      "url": "https://github.com/LineageOS/android_device_xiaomi_garnet",
      "commit": "5b3cb512c2f07f416eaa461e2ade28cead2e2760",
      "paths": [
        "BoardConfig.mk (TARGET_BOARD_PLATFORM := parrot)"
      ],
      "license": "Apache-2.0",
      "use": "ro.board.platform value of a Qualcomm platform (no SM number or marketing name is stated there)"
    },
    {
      "id": "linux-mainline",
      "url": "https://github.com/torvalds/linux",
      "commit": "7be4bc52fd9e0e55dc9a2e0232b89427d2c4b614",
      "paths": [
        "drivers/soc/qcom/socinfo.c",
        "Documentation/devicetree/bindings/arm/qcom.yaml",
        "Documentation/devicetree/bindings/arm/mediatek.yaml",
        "Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml",
        "Documentation/devicetree/bindings/arm/google.yaml"
      ],
      "license": "GPL-2.0 (kernel); identifiers are used as facts, no code is copied",
      "use": "known_platforms"
    }
  ],
  "family_rules": [
    {
      "family": "qualcomm",
      "signal": "dt_compatible",
      "vendor": "qcom",
      "model_prefixes": [
        "msm",
        "sdm",
        "sm",
        "sc",
        "qcs",
        "qcm",
        "sa",
        "sar",
        "sdx",
        "apq",
        "x1e",
        "x1p",
        "qdu",
        "qru"
      ],
      "source": "linux-mainline"
    },
    {
      "family": "qualcomm",
      "signal": "soc0_family",
      "exact": [
        "Snapdragon"
      ],
      "source": "linux-mainline"
    },
    {
      "family": "qualcomm",
      "signal": "board_platform",
      "exact": [
        "parrot"
      ],
      "source": "lineage-garnet"
    },
    {
      "family": "mediatek",
      "signal": "dt_compatible",
      "vendor": "mediatek",
      "model_prefixes": [
        "mt"
      ],
      "source": "linux-mainline"
    },
    {
      "family": "samsung_exynos",
      "signal": "dt_compatible",
      "vendor": "samsung",
      "model_prefixes": [
        "exynosauto",
        "exynos"
      ],
      "source": "linux-mainline"
    },
    {
      "family": "google_tensor",
      "signal": "dt_compatible",
      "vendor": "google",
      "model_prefixes": [
        "gs"
      ],
      "source": "linux-mainline"
    },
    {
      "family": "google_tensor",
      "signal": "board_platform",
      "exact": [
        "gs101",
        "gs201",
        "zuma"
      ],
      "source": "lineage-gs101 lineage-gs201 lineage-zuma"
    }
  ],
